# Copy to .env.local and fill in. .env.local is git-ignored.

# Your interview workspace (the directory with profile.md). Without it the
# dashboard shows the bundled demo workspaces only (read-only).
WORKSPACE_DIR=/absolute/path/to/my-interview-prep

# More workspaces for the switcher, comma-separated (optional).
# WORKSPACE_DIRS=/path/one,/path/two

# Needed only for the AI practice room (/mock, /debrief). An `ant auth login`
# profile also works instead of a key.
ANTHROPIC_API_KEY=

# Force the UI language (zh | en). Default: `language` in the workspace's profile.md.
# UI_LANGUAGE=zh

# Model override (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5
